generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}
enum UserRole {
  SALES_OFFICER
  MANAGER
}

enum ProductStatus {
  ACTIVE
  INACTIVE
}

enum SaleStatus {
  PENDING
  APPROVED
  REJECTED
}

enum StockType {
  IN
  OUT
}

enum PaymentMethod {
  CASH
  TRANSFER
  MOBILE
}
model User {
  id              String   @id @default(uuid())
  username        String   @unique
  password        String
  name            String
  role            UserRole
  preparedSales   Sale[] @relation("PreparedSales")
  approvedSales   Sale[] @relation("ApprovedSales")
  approvals       Approval[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Category {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  isActive    Boolean   @default(true)
  products    Product[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Product {
  id                 String   @id @default(uuid())
  sku                String   @unique
  name               String
  description        String?
  categoryId         Int
  category           Category @relation(fields: [categoryId], references: [id])
  costPrice          Float
  sellingPrice       Float
  stockLevel         Int @default(0)
  lowStockThreshold  Int @default(5)
  status             ProductStatus @default(ACTIVE)
  isDeleted          Boolean @default(false)
  stockHistory       InventoryTransaction[]
  saleItems          SaleItem[]
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}
model Sale {
  id                 String @id @default(uuid())
  invoiceNumber      String @unique
 subtotal           Float
  discount           Float @default(0)
  taxableAmount      Float
  vat                Float
  totalAmount        Float
  paymentMethod      PaymentMethod?
  requiresApproval   Boolean @default(false)
  status             SaleStatus @default(APPROVED)
  preparedById       String
  approvedById       String?
  preparedBy         User @relation("PreparedSales", fields: [preparedById], references: [id])
  approvedBy         User? @relation("ApprovedSales", fields: [approvedById], references: [id])
  items              SaleItem[]
  approval           Approval?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}


model SaleItem {
  id            String @id @default(uuid())
  saleId        String
  productId     String
  quantity      Int
  unitPrice     Float
  subtotal      Float
  discount      Float @default(0)
  vat           Float @default(0)
  total         Float
  sale          Sale @relation(fields: [saleId], references: [id])
  product       Product @relation(fields: [productId], references: [id])
  createdAt     DateTime @default(now())
}


model InventoryTransaction {
  id            String @id @default(uuid())
  productId     String
  type          StockType
  quantity      Int
  reason        String?
  product       Product @relation(fields: [productId], references: [id])
  createdAt     DateTime @default(now())
}

model Approval {
  id            Int @id @default(autoincrement())
  saleId        String @unique
  managerId     String
  status        String
  comment       String?
  approvedAt    DateTime @default(now())
  sale          Sale @relation(fields: [saleId], references: [id])
  manager       User @relation(fields: [managerId], references: [id])
  updatedAt     DateTime @updatedAt
}

model Report {
  id            Int @id @default(autoincrement())
  type          String
  generatedBy   String
  fileUrl       String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}


model AuditLog {
  id            String @id @default(uuid())
  userId        String
  action        String
  entity        String
  entityId      String
  createdAt     DateTime @default(now())
}